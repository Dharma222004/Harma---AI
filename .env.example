# Harma Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and configure your primary LLM provider.
# The .env file is gitignored — never commit secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Primary LLM Provider ──────────────────────────────────────────────────────
# Options: nvidia (default) | gemini | groq | openai | claude
HARMA_LLM_PROVIDER=nvidia

# ── NVIDIA NIM / Hosted LLM Configuration (Primary) ───────────────────────────
# NVIDIA Hosted API key (starts with nvapi-)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA NIM base URL (OpenAI-compatible)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Model Identifier (e.g. nemotron-3-super-120b-a12b or nvidia/nemotron-3-super-120b-a12b)
NVIDIA_MODEL=nemotron-3-super-120b-a12b

# Operational parameters
NVIDIA_TIMEOUT=120
NVIDIA_TEMPERATURE=0.2

# Strict fallback policy: if true, attempts secondary provider on NVIDIA error.
# If false (default), returns clear error without burning Gemini/Groq credits.
HARMA_LLM_FALLBACK_ENABLED=false

# ── Optional: Google Gemini (Secondary / Alternative Provider) ─────────────────
# HARMA_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_1=your_gemini_key_1
# GEMINI_API_KEY_2=your_gemini_key_2
# HARMA_MODEL=gemini-2.5-flash

# ── Optional: Groq (Secondary / Alternative Provider) ─────────────────────────
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY_1=your_groq_api_key_1
# GROQ_MODEL=openai/gpt-oss-20b

# ── Optional: OpenAI / Anthropic ──────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here
